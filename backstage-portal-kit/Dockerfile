# This Dockerfile assumes a normal Backstage application generated by
# @backstage/create-app. The official Backstage Docker workflow can use the
# generated packages/backend/Dockerfile; keep that generated Dockerfile if
# possible. This file is provided as a clear single-image alternative.

FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=4096

COPY package.json yarn.lock ./
COPY .yarn ./.yarn
COPY .yarnrc.yml ./

RUN corepack enable && yarn install --immutable

COPY . .

RUN yarn tsc
RUN yarn build:backend

USER node

EXPOSE 7007

CMD ["node", "packages/backend", "--config", "app-config.yaml", "--config", "app-config.production.yaml"]
